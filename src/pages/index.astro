---
import Footer from "../components/footer.astro"
import Head from "../components/head.astro"
import Logo from "../components/logo.astro"
import Address from "../components/sections/address.astro"
import Intro from "../components/sections/intro.astro"
import Plug from "../components/sections/plug.astro"
import "../styles/global.css"
---

<html lang="en">
  <Head />
  <body class="relative min-h-screen w-full flex flex-col px-6 py-8 md:px-16 md:py-14">
    <main class="flex flex-col w-md max-w-full gap-6 relative">
      <Logo />

      <article class="flex flex-col gap-4 text-justify">
        <Intro />
        <Plug />
      </article>

      <Address />

      <Footer />
    </main>
  </body>
</html>
