---
import Footer from "../components/footer.astro"
import Head from "../components/head.astro"
import Logo from "../components/logo.astro"
import Address from "../components/sections/address.astro"
import Intro from "../components/sections/intro.astro"
import Plug from "../components/sections/plug.astro"
import "../styles/global.css"
---

<html lang="en">
  <Head />
  <body class="min-h-screen flex flex-col pl-16 pt-14">
    <main class="flex flex-col w-md gap-6">
      <Logo />

      <article class="flex flex-col gap-4">
        <Intro />
        <Plug />
      </article>

      <Address />

      <Footer />
    </main>
  </body>
</html>
